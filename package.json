{
  "name": "@genbi/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=mysql://t@localhost/t JWT_SECRET=test-secret-0123456789 QR_SECRET=qr-secret-0123456789 tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e-flow.mjs && node tests/chat-burst.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.0.2",
    "node-cache": "5.1.2",
    "node-cron": "4.6.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
